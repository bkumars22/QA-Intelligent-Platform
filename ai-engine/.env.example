
# ─── Azure OpenAI (optional — alternative provider for defect explanations) ──
# Leave AZURE_OPENAI_API_KEY blank to use Groq (existing default).
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-02-01
# ─────────────────────────────────────────────────────────────────

# ─── LangSmith Observability ──────────────────────────────────────
# Get your key at: https://smith.langchain.com → Settings → API Keys
# Leave blank to disable tracing (zero impact on performance)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=QAIP-Production
# ─────────────────────────────────────────────────────────────────

# ─── AIMO Observability (incident detection + cost/injection monitoring) ──
# Base URL of a running AIMO AI engine. Leave blank to disable — @aimo_trace
# becomes a zero-overhead passthrough when unset.
AIMO_ENDPOINT=
# ─────────────────────────────────────────────────────────────────
